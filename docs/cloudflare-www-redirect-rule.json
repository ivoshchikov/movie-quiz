{
  "description": "Hard Quiz: canonical host and HTTPS",
  "expression": "(http.host eq \"www.hard-quiz.com\") or ((http.host eq \"hard-quiz.com\") and (not ssl))",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://hard-quiz.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": false
}
