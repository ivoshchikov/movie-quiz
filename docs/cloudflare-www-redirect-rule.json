{
  "description": "Hard Quiz: www to apex",
  "expression": "(http.host eq \"www.hard-quiz.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://hard-quiz.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": false
}
